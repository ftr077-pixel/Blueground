# VoiceBridge — configuration template.
#
# HOW TO USE: copy this file to ".env" in the same folder, then fill in the
# value after each "=". No quotes, no spaces around the "=".
#
# ".env" is listed in .gitignore and never leaves your machine.
# Never paste these values into a chat, a ticket, or a commit.
#
# Check your work at any time with:   make check-env


# ─────────────────────────────────────────────────────────────────────
# 1. TELEPHONY — Twilio          https://console.twilio.com
# ─────────────────────────────────────────────────────────────────────

# Console home page, "Account Info" panel. Starts with AC, 34 characters.
TWILIO_ACCOUNT_SID=

# Same panel, hidden behind "Show". 32 characters. This is a password.
TWILIO_AUTH_TOKEN=

# The number you bought, international format, e.g. +12025550123
# Phone Numbers -> Manage -> Active numbers
TWILIO_PHONE_NUMBER=

# Public https address where this server is reachable, no trailing slash.
# Leave empty until the server runs — SETUP.md step 5 fills it in.
PUBLIC_HOST=


# ─────────────────────────────────────────────────────────────────────
# 2. SPEECH RECOGNITION
# ─────────────────────────────────────────────────────────────────────

# Hebrew side.   https://portal.speechmatics.com  ->  API keys
SPEECHMATICS_API_KEY=

# English side.  https://console.deepgram.com  ->  API keys
DEEPGRAM_API_KEY=


# ─────────────────────────────────────────────────────────────────────
# 3. TRANSLATION
# ─────────────────────────────────────────────────────────────────────

# https://platform.openai.com/api-keys — starts with sk-
OPENAI_API_KEY=

# Defaults are fine; change only with a measurement in hand.
MT_MODEL_FAST=gpt-4o-mini
MT_MODEL_QUALITY=gpt-4o


# ─────────────────────────────────────────────────────────────────────
# 4. SPEECH SYNTHESIS
# ─────────────────────────────────────────────────────────────────────

# https://play.cartesia.ai  ->  API keys
CARTESIA_API_KEY=

# Voice IDs from the Cartesia voice library (the UUID shown under a voice).
# One voice per language: the caller hears HE, the operator hears EN.
CARTESIA_VOICE_HE=
CARTESIA_VOICE_EN=


# ─────────────────────────────────────────────────────────────────────
# 5. TUNING — leave as-is unless a measurement says otherwise (ADR-004)
# ─────────────────────────────────────────────────────────────────────

STABILITY_MS=320
MIN_STABLE_PARTIALS=2
MAX_UNCOMMITTED_MS=2500
VAD_SILENCE_MS=500
MAX_QUEUE_MS=3000


# ─────────────────────────────────────────────────────────────────────
# 6. DEPLOYMENT — only needed on the server, not on a laptop
# ─────────────────────────────────────────────────────────────────────

# Option A — you own a domain (preferred): the subdomain to serve on.
# Point its DNS A record at the box, then run deploy/install-caddy.sh
VOICE_DOMAIN=

# Option B — no domain: ngrok gives a fixed address instead.
# dashboard.ngrok.com -> Your Authtoken
NGROK_AUTHTOKEN=

# dashboard.ngrok.com -> Domains -> Create Domain
# Looks like: something-static.ngrok-free.app
NGROK_DOMAIN=
